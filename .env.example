# Base URL of the backend API, including the version prefix.
# Inlined into the bundle at build time, so never put secrets in EXPO_PUBLIC_*.
#
# Optional in development: when unset, the app uses the machine running Metro
# on port 3333 (where boilerplate-api's `yarn dev` listens). Required for
# preview and production builds.
# EXPO_PUBLIC_API_URL=https://api.example.com/v1
